{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["jest"]
  },
  "include": ["postviewer/src/**/*", "socialspec/src/**/*", "socialspec/test/**/*", "follow/src/**/*", "follow/test/**/*"]
}
